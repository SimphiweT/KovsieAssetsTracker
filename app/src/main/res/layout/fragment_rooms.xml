<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/swipeRefreshRooms"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.activities.dashboards.staffDashboard.fragments.room.RoomsFragment"
    tools:ignore="MissingClass">

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:id="@+id/coordinator_rooms"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="35dp">

        <!-- AppBarLayout -->
        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/appBarLayoutRooms"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            android:fitsSystemWindows="true"
            app:elevation="0dp">

            <androidx.appcompat.widget.Toolbar
                android:id="@+id/toolbarRooms"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@android:color/transparent"
                android:contentInsetStartWithNavigation="0dp"
                app:popupTheme="@style/ThemeOverlay.AppCompat.Light">

                <!-- SearchView -->
                <androidx.appcompat.widget.SearchView
                    android:id="@+id/searchViewRooms"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:queryHint="Search Rooms..."
                    app:iconifiedByDefault="false"
                    android:layout_marginHorizontal="6dp"
                    android:background="@drawable/search_view_bg"
                    android:focusable="true"
                    android:layout_gravity="center_vertical" />
            </androidx.appcompat.widget.Toolbar>
        </com.google.android.material.appbar.AppBarLayout>
        <TextView
            android:id="@+id/tvLastSynced"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="4dp"
            android:text="Last synced: --"
            android:textSize="12sp"
            android:textColor="@color/gray" />

        <!-- RecyclerView -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerViewRooms"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingTop="16dp"
            android:paddingBottom="16dp"
            android:overScrollMode="never"
            android:scrollbars="vertical"
            app:layout_behavior="@string/appbar_scrolling_view_behavior" />

        <!-- Empty message -->
        <TextView
            android:id="@+id/tvNoRooms"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="No rooms found"
            android:textSize="16sp"
            android:textColor="@android:color/darker_gray"
            android:gravity="center"
            android:visibility="gone" />

        <!-- Floating Sync Button -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/btnSyncRooms"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="16dp"
            android:contentDescription="Sync Rooms"
            android:src="@drawable/ic_sync"
            android:tint="@android:color/white"
            app:backgroundTint="@color/peach" />
    </androidx.coordinatorlayout.widget.CoordinatorLayout>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
