<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp"
    tools:context=".ui.activities.startups.AboutActivity">
    <!-- App Title -->
    <TextView
        android:id="@+id/tvAppTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="KovsieAssetsTracker"
        android:textAppearance="?attr/textAppearanceHeadline5"
        android:textStyle="bold"
        android:fontFamily="@font/bungee_regular"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- App Description -->
    <TextView
        android:id="@+id/tvAppDescription"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:fontFamily="@font/poppins_regular"
        android:text="KovsieAssetsTracker is an application designed to manage, track, and organize devices efficiently for staff and students."
        android:textAppearance="?attr/textAppearanceBody1"
        android:gravity="center"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/tvAppTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Card for User Info -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardUserInfo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="8dp"
        app:layout_constraintTop_toBottomOf="@id/tvAppDescription"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/tvDeveloperTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Developer Information"
                android:textAppearance="?attr/textAppearanceSubtitle1"
                android:textStyle="bold"
                android:fontFamily="@font/poppins_bold"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:id="@+id/tvFullName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Name: Simphiwe Terrence Nxumalo"
                android:fontFamily="@font/poppins_light"
                android:textAppearance="?attr/textAppearanceBody1"/>

            <TextView
                android:id="@+id/tvSapNumber"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_light"
                android:text="SAP Number: 2016401495"
                android:textAppearance="?attr/textAppearanceBody1"/>

            <TextView
                android:id="@+id/tvPhone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_light"
                android:text="Phone: 084 970 2454"
                android:textAppearance="?attr/textAppearanceBody1"/>

            <TextView
                android:id="@+id/tvEmail1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_light"
                android:text="Email 1: 2016401495@ufs4life.ac.za"
                android:textAppearance="?attr/textAppearanceBody1"/>

            <TextView
                android:id="@+id/tvEmail2"
                android:layout_width="wrap_content"
                android:fontFamily="@font/poppins_light"
                android:layout_height="wrap_content"
                android:text="Email 2: nxumalosimphiweterrence@gmail.com"
                android:textAppearance="?attr/textAppearanceBody1"/>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Back Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnBackToStartup"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Back to Startup"
        app:icon="@drawable/ic_arrow_back"
        app:iconGravity="textStart"
        app:cornerRadius="20dp"
        android:fontFamily="@font/poppins_bold"
        android:layout_marginTop="32dp"
        app:layout_constraintTop_toBottomOf="@id/cardUserInfo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>