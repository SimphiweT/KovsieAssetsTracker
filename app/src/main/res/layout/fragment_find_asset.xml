<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/coordinator_find_asset"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.activities.dashboards.staffDashboard.fragments.asset.FindAssetFragment">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <!-- Scan QR Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnScanQr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/scan_qr_code"
                app:icon="@drawable/qrcode_scan"
                app:iconGravity="start"
                app:iconTint="@color/white"
                android:layout_marginBottom="16dp"/>

            <!-- QR Preview -->
            <ImageView
                android:id="@+id/ivQrPreview"
                android:layout_width="200dp"
                android:layout_height="200dp"
                android:contentDescription="@string/asset_qr_code"
                android:scaleType="centerCrop"
                android:src="@drawable/qrcode_scan"
                android:layout_marginBottom="16dp"/>

            <!-- Asset Details Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/tvAssetName"
                        style="@style/TextAppearance.Material3.HeadlineSmall"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/asset_name_placeholder"/>

                    <TextView
                        android:id="@+id/tvAssetDescription"
                        style="@style/TextAppearance.Material3.BodyMedium"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/asset_description_placeholder"
                        android:layout_marginTop="4dp"/>

                    <TextView
                        android:id="@+id/tvAssetStatus"
                        style="@style/TextAppearance.Material3.BodyLarge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/asset_status_placeholder"
                        android:textColor="@color/navy"
                        android:layout_marginTop="8dp"/>

                    <TextView
                        android:id="@+id/tvAssetCategory"
                        style="@style/TextAppearance.Material3.BodySmall"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/asset_category_placeholder"
                        android:layout_marginTop="4dp"/>

                    <TextView
                        android:id="@+id/tvAssetRoom"
                        style="@style/TextAppearance.Material3.BodySmall"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/asset_room_placeholder"
                        android:layout_marginTop="4dp"/>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
