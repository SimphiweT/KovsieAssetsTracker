<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_marginBottom="35dp"
    tools:context=".ui.activities.dashboards.staffDashboard.fragments.asset_category.CategoriesFragment">

    <!-- AppBarLayout with fixed position -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayoutCategories"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        android:fitsSystemWindows="true"
        app:elevation="0dp">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbarCategories"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            android:contentInsetStartWithNavigation="0dp"
            app:contentInsetStart="0dp"
            app:popupTheme="@style/ThemeOverlay.AppCompat.Light">

            <!-- SearchView inside Toolbar -->
            <androidx.appcompat.widget.SearchView
                android:id="@+id/searchViewCategories"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:queryHint="Search Categories..."
                app:iconifiedByDefault="false"
                android:layout_marginHorizontal="6dp"
                android:background="@drawable/search_view_bg"
                android:focusable="true"
                android:layout_gravity="center_vertical"/>
            <ImageButton
                android:id="@+id/btnSyncCategories"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="10dp"

                android:padding="8dp"
                android:contentDescription="Sync"
                android:src="@drawable/ic_sync"
                app:tint="@color/white" />
        </androidx.appcompat.widget.Toolbar>

    </com.google.android.material.appbar.AppBarLayout>
    <!-- Empty message -->
    <TextView
        android:id="@+id/tvNoCategories"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:text="No assets categories found"
        android:textSize="16sp"
        android:textColor="@android:color/darker_gray"
        android:gravity="center"
        android:visibility="gone" />


    <!-- RecyclerView fills remaining space below AppBarLayout -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewCategories"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:layout_marginBottom="25dp"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        android:overScrollMode="never"
        android:scrollbars="vertical"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"/>

</androidx.coordinatorlayout.widget.CoordinatorLayout>