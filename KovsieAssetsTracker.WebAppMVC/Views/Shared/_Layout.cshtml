@using KovsieAssetsTracker.WebAppMVC
@using KovsieAssetsTracker.WebAppMVC.Helpers
@using KovsieAssetsTracker.WebAppMVC.Models
@inject SessionManager sessionManager

@{
    string role = sessionManager.GetRole() as string ?? "";
}

<!DOCTYPE html>
<html lang="en">
<head>

    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/x-icon" href="~/images/icon_logo_transparent.png" />
    <title>Kovsie Assets Tracker | @ViewBag.Title</title>

    <link rel="stylesheet" href="~/lib/sweetalert2/sweetalert2.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/remixicon/remixicon.min.css" />
    <link rel="stylesheet" href="~/css/style_home.css" asp-append-version="true" />

    <script src="~/lib/bootstrap/js/bootstrap.min.js" defer></script>
    <script src="~/lib/sweetalert2/sweetalert2.all.min.js" defer></script>
    <script src="~/lib/lottie-web/lottie.min.js" defer></script>
    <script src="https://unpkg.com/scrollreveal" defer></script>
    <script src="~/js/ui-helper.js" defer></script>
    <script src="~/js/script_home.js" defer></script>

</head>

<body>
    <nav>
        <!-- Navbar -->
        <div class="nav_header">
            <div class="nav_logo">
                <a href="@Url.Action("Index", "Home")">
                    <img src="~/images/icon_logo_transparent.png" alt="Kovsie Assets Tracker Logo" class="main_logo" />
                </a>
                <h2 class="main_title">KOVSIE ASSETS <span>TRACKER</span></h2>
            </div>
            <div class="nav_menu_btn" id="menu-btn">
                <span><i class="ri-menu-line"></i></span>
            </div>
        </div>
        <ul class="nav_links" id="nav-links">
            <li><a href="@Url.Action("Index", "Home")">HOME</a></li>
            <li><a href="@Url.Action("About", "Home")">ABOUT</a></li>
            <li><a href="@Url.Action("Contact", "Home")">CONTACT</a></li>
        </ul>
        <div class="nav_btns">
            <a class="btn sign_up" href="@Url.Action("RequestAccess", "Home")">Sign Up</a>
            <a class="btn sign_in" href="@Url.Action("Login", "Home")">Sign In</a>
        </div>
    </nav>

    <!-- Main content -->
    <main>
        @RenderBody()
    </main>


    <!-- Section scripts -->
    @RenderSection("Scripts", required: false)

    <!-- SweetAlert / Lottie Partial -->
    @await Html.PartialAsync("_SweetAlertPartial")

</body>
</html>
