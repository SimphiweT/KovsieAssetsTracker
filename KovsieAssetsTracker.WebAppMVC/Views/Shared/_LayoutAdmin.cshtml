@using KovsieAssetsTracker.WebAppMVC
@using KovsieAssetsTracker.WebAppMVC.Helpers
@using KovsieAssetsTracker.WebAppMVC.Models
@inject SessionManager sessionManager

@{
    string role = sessionManager.GetRole() as string ?? "";
}

<!DOCTYPE html>
<html lang="en">
<head>

    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/x-icon" href="~/images/icon_logo_transparent.png/>
    <title>Kovsie Admin | @ViewBag.Title</title>

    <link rel="stylesheet" href="~/lib/bootstrap/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/remixicon/remixicon.min.css" />
    <link rel="stylesheet" href="~/lib/sweetalert2/sweetalert2.min.css" />

    <link rel="stylesheet" href="~/css/style_admin.css" asp-append-version="true" />

    <script src="~/lib/bootstrap/js/bootstrap.min.js" defer></script>
    <script src="~/lib/sweetalert2/sweetalert2.all.min.js" defer></script>
    <script src="~/lib/lottie-web/lottie.min.js" defer></script>
    <script src="https://unpkg.com/scrollreveal" defer></script>
    <script src="~/lib/apexcharts/apexcharts.min.js" defer></script>
    <script src="~/js/ui-helper.js" defer></script>
    <script src="~/js/script_admin.js" defer></script>

</head>

<body>

    <div class="grid-container">
        <!-- Header -->
        <header class="header">
            <div class="menu-icon" onclick="openSidebar()">
                <i class="ri-menu-line remixicon-outlined"></i>
            </div>
            <div class="header-left">
                <i class="ri-search-line remixicon-outlined"></i>
            </div>
            <div class="header-right">
                <i class="ri-notification-line remixicon-outlined"></i>
                <i class="ri-mail-line remixicon-outlined"></i>
                <a href="@Url.Action("ManageProfile", "Admin")"><i class="ri-account-circle-line remixicon-outlined"></i></a>
            </div>
        </header>
        <!-- End Header -->

        <!-- Sidebar -->
        <aside id="sidebar">
            <div class="sidebar-title">
                <div class="sidebar-brand">
                    <img src="~/images/logo_white_bg_transparent.png" alt="Kovsie Logo" class="logo" />
                    <span>Kovsie Assets Tracker</span>
                </div>
                <i class="ri-close-line remixicon-outlined" onclick="closeSidebar()"></i>
            </div>

            <ul class="sidebar-list">
                <li class="sidebar-list-item">
                    <a href="@Url.Action("AdminDashboard", "Admin")" class="sidebar-link">
                        <i class="ri-dashboard-line remixicon-outlined"></i>
                        <span>Dashboard</span>
                    </a>
                </li>
                <li class="sidebar-list-item">
                    <a href="@Url.Action("ManageAssets", "Admin")" class="sidebar-link">
                        <i class="ri-folder-2-line remixicon-outlined"></i>
                        <span>Assets</span>
                    </a>
                </li>
                <li class="sidebar-list-item">
                    <a href="@Url.Action("ManageCategories", "Admin")" class="sidebar-link">
                        <i class="ri-list-check remixicon-outlined"></i>
                        <span>Categories</span>
                    </a>
                </li>
                <li class="sidebar-list-item">
                    <a href="@Url.Action("ManageUsers", "Admin")" class="sidebar-link">
                        <i class="ri-group-line remixicon-outlined"></i>
                        <span>Users</span>
                    </a>
                </li>
                <li class="sidebar-list-item">
                    <a href="@Url.Action("ManageCampuses", "Admin")" class="sidebar-link">
                        <i class="ri-school-line remixicon-outlined"></i>
                        <span>Campuses</span>
                    </a>
                </li>
                <li class="sidebar-list-item">
                    <a href="@Url.Action("ManageBuildings", "Admin")" class="sidebar-link">
                        <i class="ri-building-line remixicon-outlined"></i>
                        <span>Buildings</span>
                    </a>
                </li>
                <li class="sidebar-list-item">
                    <a href="@Url.Action("ManageFloors", "Admin")" class="sidebar-link">
                        <i class="ri-building-2-line remixicon-outlined"></i>
                        <span>Floors</span>
                    </a>
                </li>
                <li class="sidebar-list-item">
                    <a href="@Url.Action("ManageRooms", "Admin")" class="sidebar-link">
                        <i class="ri-database-line remixicon-outlined"></i>
                        <span>Rooms</span>
                    </a>
                </li>
                <li class="sidebar-list-item">
                    <a href="@Url.Action("ManageAccessRequests", "Admin")" class="sidebar-link">
                        <i class="ri-shield-user-line remixicon-outlined"></i>
                        <span>Manage Access</span>
                    </a>
                </li>
                <li class="sidebar-list-item">
                    <a href="@Url.Action("ManagePasswords", "Admin")" class="sidebar-link">
                        <i class="ri-lock-password-line remixicon-outlined"></i>
                        <span>Manage Passwords</span>
                    </a>
                </li>
 
                <li class="sidebar-list-item">
                    <a href="@Url.Action("ManageProfile", "Admin")">
                        <i class="ri-account-circle-line remixicon-outlined"></i>
                        <span class="title">Profile</span>
                    </a>
                </li>

                <li class="sidebar-list-item">
                    <a href="@Url.Action("LogOut", "Admin")">
                        <i class="ri-logout-circle-line remixicon-outlined"></i>
                        <span>Sign Out</span>
                    </a>
                </li>
      </ul>
        </aside>
        <!-- End Sidebar -->
        <!-- Main -->
        <main class="main-container"> @RenderBody()</main>
        <!-- End Main -->


    </div>


    <!-- Section scripts -->
    @RenderSection("Scripts", required: false)

    <!-- SweetAlert / Lottie Partial -->
    @await Html.PartialAsync("_SweetAlertPartial")

</body>
</html>
