@model KovsieAssetsTracker.WebAppMVC.Models.Building.DetailsAndUpdateBuildingViewModel
@{
    ViewBag.Title = "Building Details / Update";
}

<!-- ===== PAGE HEADER ===== -->
<div class="main-title">
    <h2><i class="ri-building-line"></i> BUILDING DETAILS / UPDATE</h2>
    <div class="export-btns">
        <a asp-action="ManageBuildings" asp-controller="Admin" class="btn btn-outline-light">
            <i class="ri-arrow-left-line me-1"></i> Back
        </a>
        <a asp-action="ExportBuildingsExcel" class="btn btn-excel">Excel</a>
        <a asp-action="ExportBuildingsPdf" class="btn btn-pdf">PDF</a>
    </div>
</div>

<!-- ===== MAIN WRAPPER ===== -->
<section class="asset-details-wrapper">

    <!-- ===== LEFT: BUILDING OVERVIEW ===== -->
    <div class="card glass-card asset-preview text-white shadow-soft">
        <div class="card-body text-center">
            @{
                var img = !string.IsNullOrEmpty(Model.BuildingDetails?.BuildingImage)
                ? Model.BuildingDetails.BuildingImage
                : Url.Content("~/images/default_broken.jpg");
            }

            <img src="@img" class="asset-img mb-3 rounded shadow" style="width:170px;height:170px;object-fit:cover;" />
            <h4 class="fw-bold mb-1">@Model.BuildingDetails?.BuildingName</h4>
            <p class="text-white-50 mb-2">@Model.BuildingDetails?.BuildingDescription</p>

            <div class="mt-2">
                <span class="badge bg-gradient-primary px-3 py-2">@Model.BuildingDetails?.CampusName</span>
            </div>

            <hr class="divider my-4" />

            <div class="text-start small px-4">
                <p><strong>Campus:</strong> @Model.BuildingDetails?.CampusName</p>
                <p><strong>Floors:</strong> @(Model.BuildingDetails?.Floors?.Count ?? 0)</p>
                <p><strong>Created:</strong> @Model.BuildingDetails?.CreatedDate?.ToString("yyyy-MM-dd")</p>
            </div>

            <hr class="divider my-4" />

            <div class="mt-2">
                <span class="badge bg-success me-2">
                    @(Model.BuildingDetails.IsAndroidBackedUp ? "Android Backed Up" : "Not Android Backed Up")
                </span>
                <span class="badge bg-info">
                    @(Model.BuildingDetails.IsServerBackedUp ? "Server Backed Up" : "Not Server Backed Up")
                </span>
            </div>
        </div>
    </div>

    <!-- ===== RIGHT: UPDATE FORM ===== -->
    <form asp-action="BuildingDetailsAndUpdate" method="post" enctype="multipart/form-data"
          class="card glass-card asset-form shadow-soft">
        @Html.AntiForgeryToken()

        <div class="card-header">
            <h5 class="fw-bold mb-0 text-white">
                <i class="bi bi-pencil-square me-2"></i> Update Building Details
            </h5>
        </div>

        <div class="card-body">
            <input type="hidden" name="_method" value="PUT" />
            <input type="hidden" asp-for="UpdateBuilding.BuildingServerId" name="BuildingServerId" />

            <!-- Building Name -->
            <div class="form-group mb-3">
                <label asp-for="UpdateBuilding.BuildingName" class="form-label fw-semibold">Building Name</label>
                <input asp-for="UpdateBuilding.BuildingName" class="form-control form-control-lg" placeholder="Enter building name" name="BuildingName" />
                <span asp-validation-for="UpdateBuilding.BuildingName" class="text-danger small"></span>
            </div>

            <!-- Description -->
            <div class="form-group mb-4">
                <label asp-for="UpdateBuilding.BuildingDescription" class="form-label fw-semibold">Description</label>
                <textarea asp-for="UpdateBuilding.BuildingDescription" rows="3" class="form-control form-control-lg" placeholder="Enter building description" name="BuildingDescription"></textarea>
                <span asp-validation-for="UpdateBuilding.BuildingDescription" class="text-danger small"></span>
            </div>

            <!-- Campus -->
            <div class="form-group mb-4">
                <label asp-for="UpdateBuilding.CampusServerId" class="form-label fw-semibold">Campus</label>
                <select asp-for="UpdateBuilding.CampusServerId" class="form-select form-select-lg" name="CampusServerId">
                    <option value="">Select Campus</option>
                    @foreach (var c in Model.Campuses ?? new List<KovsieAssetsTracker.WebAppMVC.Models.Campus.CampusViewModel>())
                    {
                        <option value="@c.CampusServerId" selected="@(c.CampusServerId == Model.UpdateBuilding.CampusServerId)">
                            @c.CampusName
                        </option>
                    }
                </select>
            </div>

            <!-- Image Upload -->
            <div class="form-group mb-4 text-center">
                <label asp-for="UpdateBuilding.ImageFile" class="form-label fw-semibold d-block">Change Image</label>
                <img id="buildingPreview" src="@img" class="rounded shadow mb-2 preview-img"
                     style="width:120px;height:120px;object-fit:cover;border-radius:10px;" />
                <input asp-for="UpdateBuilding.ImageFile" type="file" accept="image/*" class="form-control form-control-lg" name="ImageFile" />
            </div>

            <!-- Checkboxes -->
            <div class="d-flex flex-column gap-2 mb-4">
                <div class="form-check">
                    <input asp-for="UpdateBuilding.IsAndroidBackedUp" class="form-check-input" type="checkbox" name="IsAndroidBackedUp" />
                    <label asp-for="UpdateBuilding.IsAndroidBackedUp" class="form-check-label">Android BackedUp?</label>
                </div>
                <div class="form-check">
                    <input asp-for="UpdateBuilding.IsServerBackedUp" class="form-check-input" type="checkbox" name="IsServerBackedUp" />
                    <label asp-for="UpdateBuilding.IsServerBackedUp" class="form-check-label">Server BackedUp?</label>
                </div>
            </div>

            <!-- Buttons -->
            <div class="d-flex justify-content-end gap-3 mt-3">
                <a asp-action="ManageBuildings" asp-controller="Admin" class="btn btn-outline-light px-4">
                    <i class="bi bi-x-lg me-1"></i> Cancel
                </a>
                <button type="submit" class="btn btn-gradient px-4">
                    <i class="bi bi-save2 me-1"></i> Save Changes
                </button>
            </div>
        </div>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // === Preview selected image ===
        const fileInput = document.querySelector('input[type="file"][name="UpdateBuilding.ImageFile"]');
        const img = document.getElementById('buildingPreview');
        fileInput.addEventListener('change', e => {
            const file = e.target.files?.[0];
            if (!file) return img.src = '@(img)';
            const reader = new FileReader();
            reader.onload = ev => img.src = ev.target.result;
            reader.readAsDataURL(file);
        });
    </script>
}
