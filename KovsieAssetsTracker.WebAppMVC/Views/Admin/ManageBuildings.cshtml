@model KovsieAssetsTracker.WebAppMVC.Models.Building.CreateAndListBuildingsViewModel
@{
    ViewBag.Title = "Manage Buildings";
}

<div class="main-title">
    <h2><i class="ri-building-line"></i> MANAGE BUILDINGS</h2>
    <div class="export-btns">
        <a asp-action="ExportBuildingsExcel" class="btn btn-excel">Excel</a>
        <a asp-action="ExportBuildingsPdf" class="btn btn-pdf">PDF</a>
    </div>
</div>

<section class="manage-assets-wrapper">
    <!-- ===== LEFT: BUILDINGS LIST ===== -->
    <section class="asset-list">
        <div class="card h-100">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="mb-0 fw-semibold">All Buildings</h5>
                <input id="search-bar" class="form-control form-control-sm" placeholder="Search buildings..." />
            </div>

            <div class="card-body">
                <!-- ===== TABLE VIEW ===== -->
                <table id="buildings-table" class="table align-middle mb-0 text-center">
                    <thead>
                        <tr>
                            <th>Image</th>
                            <th>Name</th>
                            <th>Campus</th>
                            <th>Floors</th>
                            <th>Created</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Buildings != null && Model.Buildings.Any())
                        {
                            foreach (var b in Model.Buildings)
                            {
                                var img = !string.IsNullOrEmpty(b.BuildingImage)
                                ? b.BuildingImage
                                : Url.Content("~/images/default_broken.jpg");
                                <tr>
                                    <td><img src="@img" alt="@b.BuildingName" class="preview-image" /></td>
                                    <td>@b.BuildingName</td>
                                    <td>@b.CampusName</td>
                                    <td>@(b.Floors?.Count ?? 0)</td>
                                    <td>@b.CreatedDate?.ToString("yyyy-MM-dd")</td>
                                    <td>
                                        <div class="action-btns">
                                            <a asp-action="BuildingDetailsAndUpdate"
                                               asp-controller="Admin"
                                               asp-route-id="@b.BuildingServerId"
                                               class="btn btn-outline-primary btn-sm">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                            <form asp-action="DeleteBuilding" method="post" class="delete-building-form d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="buildingId" value="@b.BuildingServerId" />
                                                <button type="submit"
                                                        class="btn btn-outline-danger btn-sm delete-building-btn"
                                                        data-name="@b.BuildingName">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr><td colspan="6" class="text-muted-ux">No buildings found.</td></tr>
                        }
                    </tbody>
                </table>

                <!-- ===== GRID VIEW ===== -->
                <div id="buildings-grid" class="mt-2">
                    @if (Model.Buildings != null && Model.Buildings.Any())
                    {
                        foreach (var b in Model.Buildings)
                        {
                            var img = !string.IsNullOrEmpty(b.BuildingImage)
                            ? b.BuildingImage
                            : Url.Content("~/images/default_broken.jpg");
                            <div class="asset-card">
                                <img src="@img" alt="@b.BuildingName" class="preview-image" />
                                <h6 class="fw-semibold">@b.BuildingName</h6>
                                <div class="text-muted-ux">@b.CampusName</div>
                                <div class="small">@((b.Floors?.Count ?? 0)) Floors</div>
                                <div class="action-btns mt-2">
                                    <a asp-action="BuildingDetailsAndUpdate"
                                       asp-controller="Admin"
                                       asp-route-id="@b.BuildingServerId"
                                       class="btn btn-outline-primary btn-sm">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <form asp-action="DeleteBuilding" method="post" class="delete-building-form d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="buildingId" value="@b.BuildingServerId" />
                                        <button type="submit"
                                                class="btn btn-outline-danger btn-sm delete-building-btn"
                                                data-name="@b.BuildingName">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </div>
                        }
                    }
                </div>

                <!-- Floating Toggle -->
                <button id="toggle-view" class="fab-toggle" title="Switch View"><i class="bi bi-grid"></i></button>
            </div>
        </div>
    </section>

    <!-- ===== RIGHT: CREATE BUILDING FORM ===== -->
    <aside class="asset-form-wrapper">
        <form asp-action="ManageBuildings" method="post" enctype="multipart/form-data" class="asset-form card h-100">
            @Html.AntiForgeryToken()
            <div class="card-header">
                <h5 class="fw-bold mb-0 text-white">Register New Building</h5>
            </div>

            <div class="card-body">
                <label class="form-label">Building Image</label>
                <div class="text-center mb-3">
                    <img id="buildingPreview" src="~/images/default_broken.jpg"
                         class="rounded shadow-soft mb-2 preview-image" style="width:120px;height:120px;" />
                    <input asp-for="CreateBuilding.ImageFile" type="file" accept="image/*" class="form-control" />
                </div>

                <label asp-for="CreateBuilding.BuildingLocalId" class="form-label">RoomDB KEY</label>
                <input asp-for="CreateBuilding.BuildingLocalId" class="form-control mb-3" placeholder="RoomDB Primary KEY" />

                <label asp-for="CreateBuilding.BuildingName" class="form-label">Building Name</label>
                <input asp-for="CreateBuilding.BuildingName" class="form-control mb-3" placeholder="Building name" />

                <label asp-for="CreateBuilding.BuildingDescription" class="form-label">Description</label>
                <textarea asp-for="CreateBuilding.BuildingDescription" rows="3"
                          class="form-control mb-3" placeholder="Enter description"></textarea>

                <label asp-for="CreateBuilding.CampusServerId" class="form-label">Campus</label>
                <select asp-for="CreateBuilding.CampusServerId" class="form-select mb-3">
                    <option value="">Select Campus</option>
                    @foreach (var c in Model.Campuses ?? new List<KovsieAssetsTracker.WebAppMVC.Models.Campus.CampusViewModel>())
                    {
                        <option value="@c.CampusServerId">@c.CampusName</option>
                    }
                </select>

                <div class="form-check mb-2">
                    <input asp-for="CreateBuilding.IsAndroidBackedUp" class="form-check-input" type="checkbox" />
                    <label asp-for="CreateBuilding.IsAndroidBackedUp" class="form-check-label">Android BackedUp?</label>
                </div>

                <div class="form-check mb-3">
                    <input asp-for="CreateBuilding.IsServerBackedUp" class="form-check-input" type="checkbox" />
                    <label asp-for="CreateBuilding.IsServerBackedUp" class="form-check-label">Server BackedUp?</label>
                </div>

                <button type="submit" class="btn btn-gradient w-100 fw-bold">
                    <i class="bi bi-plus-circle me-1"></i> Add Building
                </button>
            </div>
        </form>
    </aside>
</section>

@section Scripts {
    <script>
        // ===== Grid/Table Toggle =====
        document.addEventListener("DOMContentLoaded", () => {
            const btnToggle = document.getElementById("toggle-view");
            const tableEl = document.getElementById("buildings-table");
            const gridEl = document.getElementById("buildings-grid");
            if (!btnToggle || !tableEl || !gridEl) return;
            gridEl.style.display = "none";
            let showingGrid = false;

            btnToggle.addEventListener("click", () => {
                showingGrid = !showingGrid;
                if (showingGrid) {
                    tableEl.style.display = "none";
                    gridEl.style.display = "grid";
                    btnToggle.innerHTML = '<i class="bi bi-table"></i>';
                } else {
                    gridEl.style.display = "none";
                    tableEl.style.display = "table";
                    btnToggle.innerHTML = '<i class="bi bi-grid"></i>';
                }
            });
        });

        // ===== Live Search =====
        document.getElementById("search-bar").addEventListener("input", e => {
            const term = e.target.value.toLowerCase();
            document.querySelectorAll("#buildings-table tbody tr").forEach(row => {
                row.style.display = row.innerText.toLowerCase().includes(term) ? "" : "none";
            });
        });

        // ===== Delete Confirmation =====
        document.addEventListener("click", e => {
            const btn = e.target.closest(".delete-building-btn");
            if (!btn) return;
            e.preventDefault();
            const form = btn.closest("form");
            const name = btn.dataset.name;
            Swal.fire({
                title: "Confirm Deletion",
                html: `Delete <strong>${name}</strong>?`,
                icon: "warning",
                showCancelButton: true,
                confirmButtonColor: "#d33",
                cancelButtonColor: "#6c757d",
                confirmButtonText: "Yes, delete"
            }).then(r => { if (r.isConfirmed) form.submit(); });
        });

        // ===== Image Preview =====
        const imgInput = document.querySelector('input[name="CreateBuilding.ImageFile"]');
        if (imgInput) {
            imgInput.addEventListener("change", e => {
                const f = e.target.files?.[0];
                const img = document.getElementById("buildingPreview");
                if (!f) return img.src = "~/images/default_broken.jpg";
                const r = new FileReader();
                r.onload = ev => img.src = ev.target.result;
                r.readAsDataURL(f);
            });
        }
    </script>
}
