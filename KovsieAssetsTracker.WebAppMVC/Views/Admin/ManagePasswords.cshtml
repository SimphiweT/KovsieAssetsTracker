@model KovsieAssetsTracker.WebAppMVC.Models.User.ChangePasswordViewModel
@{
    ViewBag.Title = "Manage Passwords";
}

<div class="main-title">
    <h2><i class="ri-key-2-line"></i> MANAGE PASSWORDS</h2>
    <div class="export-btns">
        <a asp-action="AdminDashboard" class="btn btn-outline-light">
            <i class="ri-arrow-left-line me-1"></i> Back
        </a>
    </div>
</div>

<section class="manage-assets-wrapper">
    <!-- ===== LEFT: CHANGE ADMIN PASSWORD ===== -->
    <section class="asset-list">
        <div class="card h-100">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="mb-0 fw-semibold"><i class="bi bi-lock me-1"></i> Change My Password</h5>
                <span class="badge bg-info text-dark">Administrator</span>
            </div>

            <div class="card-body">
                <form asp-action="ManagePasswords" method="post" novalidate>
                    @Html.AntiForgeryToken()
                    <input asp-for="UserId" type="hidden" />

                    <label asp-for="CurrentPassword" class="form-label">Current Password</label>
                    <input asp-for="CurrentPassword" class="form-control mb-3" type="password" placeholder="Enter current password" />
                    <span asp-validation-for="CurrentPassword" class="text-danger"></span>

                    <label asp-for="NewPassword" class="form-label">New Password</label>
                    <input asp-for="NewPassword" class="form-control mb-2" type="password" placeholder="Enter new password" />
                    <div class="progress mb-2">
                        <div id="strength-bar" class="progress-bar"></div>
                    </div>
                    <div id="strength-text" class="small text-muted mb-3"></div>
                    <span asp-validation-for="NewPassword" class="text-danger"></span>

                    <label asp-for="ConfirmPassword" class="form-label">Confirm Password</label>
                    <input asp-for="ConfirmPassword" class="form-control mb-3" type="password" placeholder="Confirm new password" />
                    <span asp-validation-for="ConfirmPassword" class="text-danger"></span>

                    <button class="btn btn-gradient w-100 fw-bold" type="submit">
                        <i class="bi bi-shield-lock me-1"></i> Update Password
                    </button>
                </form>
            </div>
        </div>
    </section>

    <!-- ===== RIGHT: RESET USER PASSWORD ===== -->
    <aside class="asset-form-wrapper">
        <form asp-action="ResetUserPassword" method="post" class="asset-form card h-100">
            @Html.AntiForgeryToken()
            <div class="card-header">
                <h5 class="fw-bold mb-0 text-white"><i class="bi bi-person-gear me-1"></i> Reset User Password</h5>
            </div>

            <div class="card-body">
                <label class="form-label">Select User</label>
                <select name="Email" class="form-select mb-3" required>
                    <option value="">Select user...</option>
                    @foreach (var user in ViewBag.Users as List<KovsieAssetsTracker.WebAppMVC.Models.User.UserViewModel>)
                    {
                        <option value="@user.UserEmail">@user.UsernameDisplay (@user.UserRole)</option>
                    }
                </select>

                <label class="form-label">Temporary Password</label>
                <input type="text" name="TemporaryPassword" class="form-control mb-4" placeholder="e.g., Temp@12345" required />

                <button type="submit" class="btn btn-gradient w-100 fw-bold">
                    <i class="bi bi-arrow-clockwise me-1"></i> Reset User Password
                </button>
            </div>
        </form>
    </aside>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        // ===== Password Strength Indicator =====
        const pwd = document.getElementById("NewPassword");
        const bar = document.getElementById("strength-bar");
        const text = document.getElementById("strength-text");

        if (pwd) {
            pwd.addEventListener("input", () => {
                const v = pwd.value;
                let s = 0;
                if (v.length >= 8) s++;
                if (/[A-Z]/.test(v)) s++;
                if (/[0-9]/.test(v)) s++;
                if (/[^A-Za-z0-9]/.test(v)) s++;
                const pct = (s / 4) * 100;
                const colors = ["#dc3545", "#ffc107", "#0dcaf0", "#28a745"];
                const labels = ["Weak", "Fair", "Good", "Strong"];
                bar.style.width = pct + "%";
                bar.style.backgroundColor = colors[s - 1] || "#ccc";
                text.textContent = labels[s - 1] || "";
            });
        }

        // ===== SweetAlert Feedback =====
        @if (TempData["AlertType"] != null)
        {
                <text>
                    Swal.fire({
                        icon: '@TempData["AlertType"]',
                        title: '@TempData["AlertTitle"]',
                        text: '@TempData["AlertMessage"]',
                        confirmButtonColor: '#4e73df'
                    });
                </text>
        }
    </script>
}
