@model KovsieAssetsTracker.WebAppMVC.Models.Asset.DetailsAndUpdateAssetViewModel
@{
    ViewBag.Title = "View / Update Asset";
}

<!-- ===== PAGE HEADER ===== -->
<div class="main-title">
    <h2><i class="ri-folder-2-line"></i> VIEW & UPDATE ASSET</h2>
    <div class="export-btns">
        <a asp-action="ManageAssets" class="btn btn-outline-light">
            <i class="ri-arrow-left-line me-1"></i> Back
        </a>
        <a asp-action="ExportAssetsExcel" class="btn btn-excel">Excel</a>
        <a asp-action="ExportAssetsPdf" class="btn btn-pdf">PDF</a>
    </div>
</div>

<!-- ===== MAIN WRAPPER ===== -->
<section class="asset-details-wrapper">
    <!-- ===== LEFT: ASSET PREVIEW ===== -->
    <div class="card glass-card asset-preview text-white shadow-soft">
        <div class="card-body text-center">
            @{
                var img = !string.IsNullOrEmpty(Model.AssetDetails?.AssetImage)
                ? Model.AssetDetails.AssetImage
                : Url.Content("~/images/default-asset.png");
                var qr = !string.IsNullOrEmpty(Model.AssetDetails?.AssetQRCodeImage)
                ? Model.AssetDetails.AssetQRCodeImage
                : Url.Content("~/images/default_qr.png");
            }

            <img src="@img" class="asset-img mb-3 rounded shadow" style="width:160px;height:160px;object-fit:cover;" />
            <h4 class="fw-bold mb-1">@Model.AssetDetails?.AssetName</h4>
            <small class="text-white-50 d-block mb-2">@Model.AssetDetails?.AssetCategoryName</small>
            <span class="badge bg-gradient-primary px-3 py-2">@Model.AssetDetails?.Status</span>

            <hr class="divider my-3" />
            <h6 class="fw-semibold">QR Code</h6>
            <img src="@qr" alt="QR" class="asset-qr my-2 rounded" style="width:130px;height:130px;background:#fff;padding:6px;" />
            <button class="btn btn-gradient btn-sm mt-2" onclick="printQR('@qr','@Model.AssetDetails?.AssetName')">
                <i class="bi bi-printer me-1"></i> Print Label
            </button>

            <hr class="divider my-4" />
            <div class="text-start small px-3">
                <p><strong>Room:</strong> @Model.AssetDetails?.RoomName</p>
                <p><strong>Description:</strong> @Model.AssetDetails?.AssetDescription</p>
                <p><strong>Created:</strong> @Model.AssetDetails?.CreatedDate?.ToString("yyyy-MM-dd")</p>
                <p><strong>Updated:</strong> @Model.AssetDetails?.UpdatedDate?.ToString("yyyy-MM-dd")</p>
            </div>
        </div>
    </div>

    <!-- ===== RIGHT: UPDATE FORM ===== -->
    <form asp-action="AssetsDetailsAndUpdate" method="post" enctype="multipart/form-data"
          class="card glass-card asset-form shadow-soft">
        @Html.AntiForgeryToken()

        <div class="card-header">
            <h5 class="fw-bold mb-0 text-white">
                <i class="bi bi-pencil-square me-2"></i> Update Asset Details
            </h5>
        </div>

        <div class="card-body">
            <input type="hidden" name="_method" value="PUT" />
            <input type="hidden" asp-for="UpdateAsset.AssetServerId" name="AssetServerId" />

            <!-- Primary Key -->
            <div class="form-group mb-3">
                <label asp-for="UpdateAsset.AssetLocalId" class="form-label fw-semibold">RoomDB Primary Key</label>
                <input asp-for="UpdateAsset.AssetLocalId" class="form-control form-control-lg" placeholder="RoomDB Primary Key" name="AssetLocalId" />
            </div>

            <!-- Asset Name -->
            <div class="form-group mb-3">
                <label asp-for="UpdateAsset.AssetName" class="form-label fw-semibold">Asset Name</label>
                <input asp-for="UpdateAsset.AssetName" class="form-control form-control-lg" placeholder="Asset Name" name="AssetName" />
            </div>

            <!-- Description -->
            <div class="form-group mb-4">
                <label asp-for="UpdateAsset.AssetDescription" class="form-label fw-semibold">Description</label>
                <textarea asp-for="UpdateAsset.AssetDescription" rows="3" class="form-control form-control-lg" placeholder="Enter asset description" name="AssetDescription"></textarea>
            </div>

            <!-- Category and Room -->
            <div class="row mb-3">
                <div class="col-md-6">
                    <label asp-for="UpdateAsset.AssetCategoryServerId" class="form-label fw-semibold">Category</label>
                    <select asp-for="UpdateAsset.AssetCategoryServerId" class="form-select form-select-lg" name="AssetCategoryServerId">
                        <option value="">Select Category</option>
                        @foreach (var c in Model.Categories)
                        {
                            <option value="@c.AssetCategoryServerId"
                                    selected="@(c.AssetCategoryServerId == Model.AssetDetails?.AssetCategoryServerId)">
                                @c.AssetCategoryName
                            </option>
                        }
                    </select>
                </div>
                <div class="col-md-6">
                    <label asp-for="UpdateAsset.RoomServerId" class="form-label fw-semibold">Room</label>
                    <select asp-for="UpdateAsset.RoomServerId" class="form-select form-select-lg" name="RoomServerId">
                        <option value="">Select Room</option>
                        @foreach (var r in Model.Rooms)
                        {
                            <option value="@r.RoomServerId"
                                    selected="@(r.RoomServerId == Model.AssetDetails?.RoomServerId)">
                                @r.RoomName
                            </option>
                        }
                    </select>
                </div>
            </div>

            <!-- Status -->
            <div class="form-group mb-4">
                <label asp-for="UpdateAsset.Status" class="form-label fw-semibold">Status</label>
                <select asp-for="UpdateAsset.Status" class="form-select form-select-lg" name="Status">
                    <option>Available</option>
                    <option>Deployed</option>
                    <option>In_Repair</option>
                    <option>Out_Of_Service</option>
                    <option>Lost_Stolen</option>
                    <option>Received</option>
                    <option>On_Order</option>
                    <option>Under_Evaluation</option>
                </select>
            </div>

            <!-- Files -->
            <div class="form-group mb-4">
                <label asp-for="UpdateAsset.ImageFileAsset" class="form-label fw-semibold">Update Asset Image</label>
                <input asp-for="UpdateAsset.ImageFileAsset" type="file" accept="image/*" class="form-control form-control-lg" name="ImageFileAsset" />
            </div>

            <div class="form-group mb-4">
                <label asp-for="UpdateAsset.ImageFileQrCode" class="form-label fw-semibold">Update QR Code (optional)</label>
                <input asp-for="UpdateAsset.ImageFileQrCode" type="file" accept="image/*" class="form-control form-control-lg" name="ImageFileQrCode" />
            </div>

            <!-- Checkboxes -->
            <div class="d-flex flex-column gap-2 mb-4">
                <div class="form-check">
                    <input asp-for="UpdateAsset.IsAndroidBackedUp" class="form-check-input" type="checkbox" name="IsAndroidBackedUp" />
                    <label asp-for="UpdateAsset.IsAndroidBackedUp" class="form-check-label">Android BackedUp?</label>
                </div>
                <div class="form-check">
                    <input asp-for="UpdateAsset.IsServerBackedUp" class="form-check-input" type="checkbox" name="IsServerBackedUp" />
                    <label asp-for="UpdateAsset.IsServerBackedUp" class="form-check-label">Server BackedUp?</label>
                </div>
            </div>

            <!-- Buttons -->
            <div class="d-flex justify-content-end gap-3 mt-3">
                <a asp-action="ManageAssets" class="btn btn-outline-light px-4">
                    <i class="bi bi-x-lg me-1"></i> Cancel
                </a>
                <button type="submit" class="btn btn-gradient px-4">
                    <i class="bi bi-save me-1"></i> Save Changes
                </button>
            </div>
        </div>
    </form>
</section>

@section Scripts {
    <script>
        function printQR(src, name) {
            const w = window.open('');
            w.document.write(`<div style="text-align:center;font-family:sans-serif;">
                <img src="${src}" style="width:200px;height:200px;border-radius:8px;margin:auto;display:block;">
                <h3>${name ?? ''}</h3></div>`);
            w.print();
            w.close();
        }
    </script>
}
