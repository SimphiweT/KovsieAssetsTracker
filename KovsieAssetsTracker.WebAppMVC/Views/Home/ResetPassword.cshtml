@model KovsieAssetsTracker.WebAppMVC.Models.Account.ResetPasswordViewModel
@{
    ViewBag.Title = "Reset Password";
}

<section class="wrapper">
    <div class="login_box">
        <div class="login_header">
            <span><i class="ri-key-2-line"></i> Reset Password</span>
        </div>

        <form asp-action="ResetPassword" method="post" class="reset_form">
            @Html.AntiForgeryToken()

            <div class="input_box">
                <input type="email" asp-for="Email" class="input_field" readonly />
                <label class="label">Email</label>
                <i class="ri-mail-line icon"></i>
            </div>

            <div class="input_box">
                <input type="text" asp-for="Token" class="input_field" readonly />
                <label class="label">Token</label>
                <i class="ri-lock-line icon"></i>
            </div>

            <div class="input_box">
                <input type="password" asp-for="NewPassword" class="input_field" required />
                <label class="label">New Password</label>
                <i class="ri-key-line icon"></i>
            </div>

            <button type="submit" class="input-submit">
                <i class="ri-check-line"></i> Reset Password
            </button>

            <p class="register">
                Back to <a asp-action="Login" asp-controller="Home">Login</a>
            </p>
        </form>

        <div id="lottie-reset" style="width:150px;height:150px;margin:auto;margin-top:20px;"></div>
    </div>
</section>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            UIHelper.showAnimation("Login", "lottie-reset", true);
        });
    </script>
}
