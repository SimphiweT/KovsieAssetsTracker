@model KovsieAssetsTracker.WebAppMVC.Models.Account.ForgotPasswordViewModel
@{
    ViewBag.Title = "Forgot Password";
}

<section class="wrapper">
    <div class="login_box">
        <div class="login_header">
            <span><i class="ri-lock-unlock-line"></i> Forgot Password</span>
        </div>

        <form asp-action="ForgotPassword" method="post" class="reset_form">
            @Html.AntiForgeryToken()

            <p class="text-center" style="color:#aaa; margin-bottom:1.2rem;">
                Enter your registered email address and we’ll send a link to reset your password.
            </p>

            <div class="input_box">
                <input type="email" asp-for="Email" class="input_field" required />
                <label class="label">Email Address</label>
                <i class="ri-mail-line icon"></i>
            </div>

            <button type="submit" class="input-submit">
                <i class="ri-send-plane-line"></i> Send Reset Link
            </button>

            <p class="register">
                Remember your password? <a asp-action="Login" asp-controller="Home">Sign In</a>
            </p>
        </form>

        <div id="lottie-forgot" style="width:150px;height:150px;margin:auto;margin-top:20px;"></div>
    </div>
</section>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            UIHelper.showAnimation("Forgot", "lottie-forgot", true);
        });
    </script>
}
