@model KovsieAssetsTracker.WebAppMVC.Models.User.ChangePasswordViewModel
@{
    ViewBag.Title = "Change Password";
}
<div class="main-title">
    <h2><i class="ri-key-fill"></i>Change Password</h2>
</div>
<section class="change-password-container">
    <!-- Left: Animation -->
    <div class="change-left">
        <div id="lottie-password" class="lottie-box"></div>
        <h2 class="gradient-text">Keep Your Account Secure</h2>
        <p>Update your password regularly to ensure your Kovsie Assets Tracker account remains protected.</p>
    </div>

    <!-- Right: Form -->
    <div class="change-right">
        <div class="password-card">
            <div class="password-card-header">
                <i class="ri-lock-password-line me-2"></i> Change Password
            </div>

            <form asp-action="ChangePassword" method="post" novalidate class="password-form">
                @Html.AntiForgeryToken()
                <input asp-for="UserId" type="hidden" />

                <div class="form-group">
                    <label asp-for="CurrentPassword">Current Password</label>
                    <div class="input-wrapper">
                        <input asp-for="CurrentPassword" id="currentPassword" class="form-control password-field" type="password" placeholder="Enter current password" />
                        <i class="ri-eye-off-line toggle-eye" data-target="#currentPassword"></i>
                    </div>
                    <div class="caps-warning">⚠️ Caps Lock is ON</div>
                </div>

                <div class="form-group">
                    <label asp-for="NewPassword">New Password</label>
                    <div class="input-wrapper">
                        <input asp-for="NewPassword" id="newPassword" class="form-control password-field" type="password" placeholder="Enter new password" />
                        <i class="ri-eye-off-line toggle-eye" data-target="#newPassword"></i>
                    </div>
                    <div class="caps-warning">⚠️ Caps Lock is ON</div>
                    <div class="progress mt-2">
                        <div id="strength-bar" class="progress-bar"></div>
                    </div>
                    <div id="strength-text" class="strength-text"></div>
                </div>

                <div class="form-group">
                    <label asp-for="ConfirmPassword">Confirm New Password</label>
                    <div class="input-wrapper">
                        <input asp-for="ConfirmPassword" id="confirmPassword" class="form-control password-field" type="password" placeholder="Confirm new password" />
                        <i class="ri-eye-off-line toggle-eye" data-target="#confirmPassword"></i>
                    </div>
                    <div class="caps-warning">⚠️ Caps Lock is ON</div>
                </div>

                <button type="submit" class="btn-submit">
                    <i class="ri-refresh-line me-1"></i> Update Password
                </button>
            </form>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            UIHelper.showAnimation("Security", "lottie-password", true);

            // Password Strength
            const pwd = document.getElementById("newPassword");
            const bar = document.getElementById("strength-bar");
            const text = document.getElementById("strength-text");
            pwd.addEventListener("input", () => {
                const v = pwd.value;
                let s = 0;
                if (v.length >= 8) s++;
                if (/[A-Z]/.test(v)) s++;
                if (/[0-9]/.test(v)) s++;
                if (/[^A-Za-z0-9]/.test(v)) s++;
                const pct = (s / 4) * 100;
                const colors = ["#dc3545", "#ffc107", "#0dcaf0", "#28a745"];
                const labels = ["Weak", "Fair", "Good", "Strong"];
                bar.style.width = pct + "%";
                bar.style.backgroundColor = colors[s - 1] || "#ccc";
                text.textContent = labels[s - 1] || "";
            });

            // Toggle visibility
            document.querySelectorAll(".toggle-eye").forEach(icon => {
                icon.addEventListener("click", () => {
                    const input = document.querySelector(icon.dataset.target);
                    input.type = input.type === "password" ? "text" : "password";
                    icon.classList.toggle("ri-eye-line");
                    icon.classList.toggle("ri-eye-off-line");
                });
            });

            // Caps Lock Warning
            document.querySelectorAll(".password-field").forEach(input => {
                const warning = input.parentElement.parentElement.querySelector(".caps-warning");
                input.addEventListener("keyup", e => warning.style.opacity = e.getModifierState("CapsLock") ? 1 : 0);
                input.addEventListener("blur", () => warning.style.opacity = 0);
            });

            // Success Animation + Redirect
            @if (TempData["AlertType"] != null)
            {
                    <text>
                        Swal.fire({
                            icon: '@TempData["AlertType"]',
                            title: '@TempData["AlertTitle"]',
                            text: '@TempData["AlertMessage"]',
                            confirmButtonColor: '#4e73df'
                        }).then(result => {
                            if ('@TempData["AlertType"]' === 'success') {
                                UIHelper.showAnimation("Success", "lottie-password", false);
                                setTimeout(() => window.location.href = '/Account/Login', 2500);
                            }
                        });
                    </text>
            }
        });
    </script>
}
