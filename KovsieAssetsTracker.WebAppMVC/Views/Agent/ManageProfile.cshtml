@model KovsieAssetsTracker.WebAppMVC.Models.User.DetailsAndUpdateUserViewModel
@{
    ViewBag.Title = "My Profile";
    var img = !string.IsNullOrEmpty(Model?.UserDetails?.ProfileImageFileName)
        ? Model.UserDetails.ProfileImageFileName
        : Url.Content("~/images/profile_placeholder.png");
}

<!-- ===== PAGE HEADER ===== -->
<div class="main-title">
    <h2><i class="ri-user-line"></i> My Profile</h2>
    <div class="export-btns">
        <a asp-action="StaffDashboard" class="btn btn-outline-light">
            <i class="ri-arrow-left-line me-1"></i>Back
        </a>
    </div>
</div>

<!-- ===== MAIN WRAPPER ===== -->
<section class="asset-details-wrapper">

    <!-- ===== LEFT: PROFILE CARD ===== -->
    <div class="asset-preview card text-white">
        <div class="card-body text-center">
            <img id="profilePreview" src="@img" alt="Profile Picture"
                 class="asset-img mb-3 rounded-circle border border-3 border-light"
                 style="width:140px;height:140px;object-fit:cover;" />

            <h4 class="fw-bold text-white">@Model?.UserDetails?.UsernameDisplay</h4>
            <div class="text-white-50">@Model?.UserDetails?.UserRole</div>

            <hr class="divider" />

            <div class="text-start small">
                <div class="mb-2"><i class="ri-mail-line me-1"></i><strong>Email:</strong> @Model?.UserDetails?.UserEmail</div>
                <div class="mb-2"><i class="ri-phone-line me-1"></i><strong>Contact:</strong> @Model?.UserDetails?.ContactNumber</div>
                <div class="mb-2"><i class="ri-calendar-line me-1"></i><strong>Joined:</strong> @Model?.UserDetails?.CreatedDate?.ToString("yyyy-MM-dd")</div>
                <div class="mt-2"><strong>About:</strong> @Model?.UserDetails?.Description</div>
            </div>
        </div>
    </div>

    <!-- ===== RIGHT: UPDATE FORM ===== -->
    <form asp-action="ManageProfile" method="post" enctype="multipart/form-data" class="asset-update-form card">
        @Html.AntiForgeryToken()
        <div class="card-header">
            <h5 class="mb-0"><i class="ri-edit-line me-2"></i> Update Profile</h5>
        </div>

        <div class="card-body">
            <input type="hidden" name="_method" value="PUT" />
            <input type="hidden" asp-for="UpdateUser.UserId" name="UserId" />

            <div class="mb-3">
                <label asp-for="UpdateUser.UsernameDisplay" class="form-label">Full Name</label>
                <input asp-for="UpdateUser.UsernameDisplay" class="form-control" name="UsernameDisplay" />
                <span asp-validation-for="UpdateUser.UsernameDisplay" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="UpdateUser.UserEmail" class="form-label">Email</label>
                <input asp-for="UpdateUser.UserEmail" class="form-control" readonly name="UserEmail" />
            </div>

            <div class="mb-3">
                <label asp-for="UpdateUser.StudentStaffNumber" class="form-label">Staff / Student No.</label>
                <input asp-for="UpdateUser.StudentStaffNumber" class="form-control" readonly name="StudentStaffNumber" />
            </div>

            <div class="mb-3">
                <label asp-for="UpdateUser.ContactNumber" class="form-label">Contact Number</label>
                <input asp-for="UpdateUser.ContactNumber" class="form-control" name="ContactNumber" />
                <span asp-validation-for="UpdateUser.ContactNumber" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="UpdateUser.Description" class="form-label">About You</label>
                <textarea asp-for="UpdateUser.Description" rows="3" class="form-control" name="Description"></textarea>
            </div>

            <div class="mb-3">
                <label asp-for="UpdateUser.ImageFile" class="form-label">Profile Image</label>
                <input asp-for="UpdateUser.ImageFile" type="file" accept="image/*" class="form-control" id="ImageFile" name="ImageFile" />
            </div>

            <div class="d-flex justify-content-end gap-2">
                <a asp-action="StaffDashboard" class="btn btn-secondary px-4">Cancel</a>
                <button class="btn btn-success px-4"><i class="ri-save-3-line me-1"></i> Save Changes</button>
            </div>
        </div>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        // Real-time image preview
        const input = document.getElementById('ImageFile');
        const preview = document.getElementById('profilePreview');
        input?.addEventListener('change', e => {
            const file = e.target.files[0];
            if (file && file.type.startsWith('image/')) {
                const reader = new FileReader();
                reader.onload = ev => {
                    preview.src = ev.target.result;
                    preview.style.transform = 'scale(1.05)';
                    setTimeout(() => preview.style.transform = 'scale(1)', 200);
                };
                reader.readAsDataURL(file);
            }
        });
    </script>
}
